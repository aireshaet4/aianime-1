@"
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

CRON_SECRET=dev-cron-token

OPENAI_API_KEY=your_openai_api_key

KODIK_TOKEN=your_kodik_token
ENABLE_KODIK_SYNC=1
ENABLE_KODIK_PLAYER_SYNC=1
ENABLE_KODIK_PLAYER_RUNTIME=0

ENABLE_SUPABASE_RUNTIME=1
NEXT_PUBLIC_ENABLE_SUPABASE_RUNTIME=1

ENABLE_REMOTE_IMAGES=1
NEXT_PUBLIC_ENABLE_REMOTE_IMAGES=1
"@ | Set-Content .env.example -Encoding utf8